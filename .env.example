# Formspree: para que el formulario de contacto envíe emails a tu bandeja.
# 1. Crea una cuenta en https://formspree.io
# 2. Crea un formulario y copia el ID (ej: xyzabcde)
# 3. Crea un archivo .env con esta línea (reemplaza con tu ID):
# VITE_FORMSPREE_ID=xyzabcde
# Sin esto, al enviar se abrirá tu cliente de correo (mailto) como respaldo.

VITE_FORMSPREE_ID=
